POSTGRES_DB=arm112
POSTGRES_USER=arm112
POSTGRES_PASSWORD=arm112
POSTGRES_PORT=55432
BACKEND_PORT=8080
FRONTEND_PORT=3000
ARM112_JWT_SECRET=local-training-secret-key-change-me-2026
ARM112_ALLOWED_ORIGINS=http://localhost:3000
ARM112_SWAGGER_PUBLIC=true
ARM112_BACKUP_RETENTION_DAYS=14
# Для production укажите путь к отдельному диску/NFS; Compose смонтирует его в контейнер.
ARM112_OFFSITE_BACKUP_DIR=./offsite-backups

# Эти адреса встраиваются во frontend во время docker compose build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/v1

# Пароли сидовых учётных записей admin / teacher / trainee (применяются при первом старте на пустой базе)
ARM112_SEED_ADMIN_PASSWORD=admin
ARM112_SEED_TEACHER_PASSWORD=teacher
ARM112_SEED_TRAINEE_PASSWORD=trainee

# Наполняет обе страницы аналитики 10 завершёнными занятиями, 2 черновиками
# и несколькими демонстрационными обучающимися. Повторный запуск не создаёт дубли.
ARM112_SEED_ANALYTICS_DEMO_ENABLED=true
